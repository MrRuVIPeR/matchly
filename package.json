{
  "name": "allowly",
  "version": "1.0.2",
  "main": "dist",
  "author": "Alexey Gorshkov",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^8.0.0",
    "fs-extra": "^11.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.33.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --dts --outDir dist",
    "lint": "clear && npx biome check src --write",
    "lint:fix": "npx biome check src --fix --unsafe",
    "dev": "tsc --noEmit && npm run lint && tsx watch src/index.ts",
    "dev:watch": "tsx watch src/index.ts --inspect",
    "test": "vitest --silent --coverage",
    "test:verbose": "vitest --coverage"
  },
  "license": "ISC",
  "description": "allowly — lightweight string matcher with whitelist/blacklist rules, wildcards, and RegExp support. Perfect for validating inputs, configs, or ACLs with strict or tolerant rule handling.",
  "resolutions": {
    "@types/express-serve-static-core": "*"
  }
}
