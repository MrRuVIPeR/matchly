{
  "name": "matchly",
  "version": "1.0.0",
  "main": "dist",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/gitlab": "^13.2.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^8.0.0",
    "fs-extra": "^11.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --dts --outDir dist",
    "lint": "clear && npx biome check src --write",
    "lint:fix": "npx biome check src --fix --unsafe",
    "dev": "tsc --noEmit && npm run lint && tsx watch src/index.ts",
    "dev:watch": "tsx watch src/index.ts --inspect",
    "test": "vitest --silent --coverage",
    "test:verbose": "vitest --coverage"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "resolutions": {
    "@types/express-serve-static-core": "*"
  }
}