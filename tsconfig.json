{
  "compilerOptions": {
    "target": "es2022",
    "outDir": "./dist",
    "lib": ["es2022"],
    "module": "NodeNext",
    "rootDir": ".",
    "baseUrl": ".",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strictFunctionTypes": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "noEmit": false,
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "inlineSources": true,
    "paths": {
      "@lib/*": ["src/lib/*"]
    }
  }
}
